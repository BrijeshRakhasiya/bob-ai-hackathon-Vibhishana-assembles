# RouteGuard AI - backend environment variables
# Copy this file to .env and fill in your real values.
# NEVER commit .env - it is in .gitignore.

# --- LLM backend (Groq - OpenAI-compatible) ---
# Groq provides a free-tier API at https://console.groq.com
# Model: openai/gpt-oss-120b (fast, capable)
LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_API_KEY=your-groq-api-key-here
LLM_MODEL=openai/gpt-oss-120b

# --- CrewAI uses the same LLM settings above ---
# CrewAI 1.x reads LLM_API_KEY and LLM_BASE_URL directly from the
# LLM object passed to each Agent (see app/agents/carrier_negotiation.py).
# No separate OPENAI_* vars are needed.

# --- Live disruption feed ---
# GDACS is public and requires no key.
# NHAI has no public real-time API - seeded data is used instead.

# --- App ---
ENVIRONMENT=development
